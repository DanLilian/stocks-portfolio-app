# Copy to .env to override the defaults in docker-compose.yml.

# "yahoo" for live prices, "static" for fixed prices that need no network access.
MARKET_DATA_PROVIDER=yahoo

# How long a quote is served from memory before it is fetched again.
QUOTE_TTL_SECONDS=30

# How often the worker records a valuation of every portfolio.
SNAPSHOT_INTERVAL_SECONDS=300
